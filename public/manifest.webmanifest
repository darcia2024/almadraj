      "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Toko kitab",
      "short_name": "Kitab",
      "description": "Pustaka dan toko buku Al Madraj",
      "url": "/buku?source=pwa-shortcut",
      "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
