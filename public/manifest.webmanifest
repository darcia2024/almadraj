      "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Katalog program",
      "short_name": "Katalog",
      "description": "Lihat dars dan bimbel yang tersedia",
